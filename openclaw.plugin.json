{
  "id": "gateway-ngrok",
  "name": "Gateway ngrok Tunnel",
  "description": "Expose local OpenClaw gateway over ngrok using the ngrok JS SDK, with optional OAuth traffic policy.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": { "type": "boolean", "default": true },
      "autoStart": { "type": "boolean", "default": false },
      "gatewayUrl": { "type": "string", "default": "http://127.0.0.1:18789" },
      "authtoken": { "type": "string" },
      "domain": { "type": "string" },
      "oauth": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": false },
          "provider": { "type": "string", "enum": ["github", "google"], "default": "github" },
          "allowedUsers": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          }
        }
      }
    }
  },
  "uiHints": {
    "authtoken": { "label": "ngrok Auth Token", "sensitive": true },
    "autoStart": { "label": "Auto-start tunnel on gateway startup" },
    "gatewayUrl": { "label": "Local gateway URL" },
    "domain": { "label": "Reserved ngrok domain (optional)" },
    "oauth": { "label": "OAuth Access Policy" }
  }
}
